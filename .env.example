# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 14+. On serverless hosts use the pooled URL.
DATABASE_URL="postgresql://intelpro:intelpro@localhost:5432/intelpro?schema=public"

# ─── Sessions and links ──────────────────────────────────────────────────────
# Required. Keys the HMAC of session and email tokens. Generate: openssl rand -hex 32
# Rotating it signs everyone out and invalidates outstanding email links.
SESSION_SECRET="replace-with-64-hex-chars"
# Public origin. Must be https:// in production. Used in email links and wallet-link messages.
APP_URL="http://localhost:3000"
# Set to "false" only for local experiments: lets unverified accounts create markets.
REQUIRE_EMAIL_VERIFICATION="true"

# ─── Email (verification + password reset) ───────────────────────────────────
# Transports: "resend" (production), "log" (dev: prints links to the console),
# "outbox" (dev/E2E: writes to EMAIL_OUTBOX_PATH). Production requires resend.
EMAIL_TRANSPORT="log"
RESEND_API_KEY=""
EMAIL_FROM="IntelPro <no-reply@your-domain.example>"
# EMAIL_OUTBOX_PATH="/tmp/intelpro-outbox.json"

# ─── AI intelligence engine (optional) ───────────────────────────────────────
# Without a key, IntelPro runs its deterministic rules engine and labels every
# result "Heuristic engine, not AI". It never assigns YES/NO to evidence on its own.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ─── Solana ──────────────────────────────────────────────────────────────────
# "devnet" (default) or "mainnet-beta". NEXT_PUBLIC_* values are compiled into the browser bundle.
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
# Server-side RPC for verification, balances and PREDICT discovery. A dedicated RPC is recommended:
# public devnet rate-limits getProgramAccounts.
SOLANA_RPC_URL="https://api.devnet.solana.com"

# ─── PREDICT pm-AMM (devnet constants from the official HACKATHON.md) ────────
NEXT_PUBLIC_PM_AMM_PROGRAM_ID="GV1FMGHRYBjQLaghE5fnGuYCuCcpdt3GD5xEX3TwN16y"
NEXT_PUBLIC_PM_AMM_USDC_MINT="3WQ8hCqTNwjrh8WzE2XyoZoUrd1miPcwWfMkmFPUMEWZ"
NEXT_PUBLIC_PM_AMM_FAUCET_URL="https://pm-amm-devnet.vercel.app/api/faucet"
PREDICT_ENABLED="true"

# ─── Bootstrap ───────────────────────────────────────────────────────────────
# Used once by `npm run db:seed`. The server refuses to start in production while
# SEED_ADMIN_PASSWORD is still this example value.
SEED_ADMIN_EMAIL="admin@intelpro.dev"
SEED_ADMIN_PASSWORD="change-me-now-123"

# ─── Testing only ────────────────────────────────────────────────────────────
# E2E_TEST_MODE=1 enables the email outbox endpoint and skips rate limits, and only
# takes effect when APP_URL is localhost. Never set it on a real deployment.
# E2E_TEST_MODE="1"
# E2E_DEVNET="1"   # run real devnet trading E2E tests
